{
  "name": "detect-avx",
  "version": "1.0.0",
  "description": "Detect AVX instruction set support on Intel processors",
  "keywords": [
    "addon",
    "avx",
    "avx2",
    "cpu",
    "intel",
    "napi",
    "native",
    "simd"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biw/detect-avx.git"
  },
  "files": [
    "dist",
    "prebuilds"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "build:native": "node-gyp rebuild",
    "clean": "node-gyp clean && rm -rf dist",
    "lint": "vp check",
    "prebuild": "prebuildify --napi --strip",
    "test": "vp test run",
    "prepublishOnly": "vp pack",
    "prepare": "vp config"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "node-gyp": "^12.1.0",
    "prebuildify": "^6.0.0",
    "typescript": "^5.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.20.0"
}
